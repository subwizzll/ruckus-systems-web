{
  "name": "ruckus-systems-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "test:scheduling": "turbo test --filter='@ruckus/scheduling-*'",
    "clean": "turbo clean && rm -rf node_modules .turbo bun.lock*",
    "rebuild": "bun clean && bun i && bun run build",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:migrate": "turbo run migrate --filter=@workspace/database",
    "db:migrate:scheduling": "bun run --filter @ruckus/scheduling-database migrate",
    "db:migrate:down": "turbo run migrate:down --filter=@workspace/database",
    "db:migrate:create": "turbo run migrate:create --filter=@workspace/database",
    "db:migrate:redo": "turbo run migrate:redo --filter=@workspace/database",
    "db:migrate:reset": "turbo run migrate:reset --filter=@workspace/database",
    "seed:admin": "turbo run seed:admin --filter=@workspace/backend"
  },
  "workspaces": [
    "apps/*",
    "packages/backend",
    "packages/database",
    "packages/eslint-config",
    "packages/typescript-config",
    "packages/ui",
    "packages/ruckus-integrations/packages/*"
  ],
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@ruckus/typescript-config": "workspace:*",
    "@types/bun": "^1.2.22",
    "prettier": "^3.2.5",
    "turbo": "^2.3.0",
    "typescript": "5.5.4"
  },
  "packageManager": "bun@1.2.21",
  "engines": {
    "node": ">=20"
  }
}
