---
import Layout from '../layouts/Layout.astro'

const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jared Russell',
  jobTitle: 'Data Engineer & AI Concierge',
  url: 'https://jared.ruckussystems.dev/resume',
  image: 'https://jared.ruckussystems.dev/headshot2026.jpg',
  telephone: '828-357-7556',
  email: 'jared@ruckussystems.dev',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'North Carolina',
    addressRegion: 'NC',
    addressCountry: 'US',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'Ruckus Systems',
    url: 'https://ruckussystems.dev',
  },
  sameAs: [
    'https://linkedin.com/in/ruckussystems',
    'https://github.com/subwizzll',
  ],
  knowsAbout: [
    'Data Engineering',
    'CI/CD',
    'Infrastructure as Code',
    'Agentic Development',
    'AI Automation',
    'Data Pipelines',
    'FHIR',
    'Java',
    'Python',
    'TypeScript',
    'PostgreSQL',
    'AWS',
    'React Native',
  ],
})

const summary =
  'Data Engineer experienced in building, testing, and deploying robust data pipelines with Java, Python, TypeScript, React Native, PostgreSQL, and AWS. Strong focus on CI/CD and infrastructure as code, regularly using AWS CloudFormation to scaffold deployment pipelines, generate unit tests, and automate PR workflows.'

const contactItems = [
  { text: '828-357-7556', href: 'tel:828-357-7556' },
  { text: 'jared@ruckussystems.dev', href: 'mailto:jared@ruckussystems.dev' },
  { text: 'linkedin.com/in/ruckussystems', href: 'https://linkedin.com/in/ruckussystems' },
  { text: 'github.com/subwizzll', href: 'https://github.com/subwizzll' },
]

const experiences = [
  {
    title: 'Data Engineer',
    company: 'HealthBook+',
    location: 'Remote - Full-time',
    period: 'Oct. 2024 - Present',
    achievements: [
      'Built an Amazon Chime messaging data pipeline with Python and PostgreSQL for internal analytics on channel conversation initiators, participant roles, and participation—including engagement with agentic entities—to inform how clinical teams and automated agents collaborate in care workflows',
      'Spearheaded end-to-end integration of the Surescripts network, architecting secure patient enrollment pipelines (SFTP/mTLS) and developing Java services for continuous medication history polling and transformation via FHIR R4',
      'Developed the "Surescripts CSV Agent" using a Claude Agent to infer and normalize varied patient Census CSV formats, drastically streamlining customer data onboarding',
      'Use Cursor and Claude Code to rapidly prototype pipelines, generate unit tests, identify edge cases, and scaffold deployments; automated PR drafting from stand-up transcripts and Jira docs',
      'Engineered a scalable metrics tracking platform using Astro and Drizzle ORM, delivering real-time OKR reporting to leadership',
    ],
  },
  {
    title: 'Full Stack Engineer',
    company: 'HealthBook+',
    location: 'Remote - Full-time',
    period: 'Feb. 2024 - Oct. 2024',
    achievements: [
      'Served as sole triage specialist using Jira, DataDog, Sentry, and AWS CloudWatch to monitor the Technical Services board and resolve complex production issues',
      'Researched and implemented end-to-end testing frameworks for a React Native CI/CD pipeline using TypeScript to reduce QA overhead and enable more frequent releases',
      'Built comprehensive PDF patient health record reports in Python (Django, PostgreSQL) by aggregating and rendering FHIR clinical data for consolidated, patient-facing medical summaries; delivered end-to-end with React Native',
      'Implemented Sentry Replays and Crash Reports with custom TypeScript logging overrides to capture and investigate difficult-to-reproduce errors in the mobile app',
      'Built internal health record systems and mobile app integrations using Java, Spring Framework, and PostgreSQL to enable real-time health data synchronization',
    ],
  },
  {
    title: 'Founder & AI Engineer',
    company: 'Ruckus Systems',
    location: 'Remote',
    period: 'Jan. 2023 - Present',
    achievements: [
      'Developed "Open Brain", a RAG memory system using PostgreSQL (pgvector) exposed via MCP to continuously build and optimize context between AI agent sessions',
      'Utilize AI development tools to accelerate coding, refactoring, and system design across TypeScript, Java, Python, React Native, PostgreSQL, AWS, Astro.js, and Vercel',
    ],
  },
  {
    title: '.NET Developer',
    company: 'R+L Carriers',
    location: 'Remote - Full-time',
    period: 'Apr. 2023 - Feb. 2024',
    achievements: [
      'Built comprehensive fuel and mileage reporting system using C#, JavaScript, ASP.NET Core, and MS SQL Server to replace legacy system, delivering data 70% faster',
      'Overhauled tablet logging system with proper event sequence management and timestamp handling to ensure 100% FMCSA compliance for driver logs',
      'Developed ELD-compliant features using ASP.NET and Xamarin to meet Federal Electronic Logging Device Mandate requirements',
    ],
  },
  {
    title: 'Software Engineer',
    company: 'Bank Mobile Technologies Inc.',
    location: 'Remote - Full-time',
    period: 'Oct. 2021 - Feb. 2023',
    achievements: [
      'Delivered Peer-to-Peer and Shared Savings features for T-Mobile Money app using Xamarin.Forms and ASP.NET Core to serve 500,000+ active users',
      'Implemented A11y features with custom Effects, MarkupExtensions, and Renderers to achieve AA+ WCAG compliance status for T-Mobile Money',
      'Delivered solutions ahead of schedule through proactive backend collaboration to achieve zero-defect releases at dev-lock for 12 consecutive sprints',
    ],
  },
  {
    title: 'Software Engineer',
    company: 'Harvest RFID',
    location: 'Remote - Contract',
    period: 'Jan. 2021 - March 2022',
    achievements: [
      'Developed real-time inventory management mobile app using Xamarin.Forms with Bluetooth Low Energy RFID integration to replace manual pen-and-paper processes, saving $10,000+ annually',
      'Built and deployed ASP.NET Core RESTful backend with cost analysis across Azure and AWS platforms to optimize deployment strategy, saving $3,000+ per year through on-premises solution',
      'Configured AppCenter Crashes and Distribution for crash analytics and deployment to improve bug resolution speed by 95%',
    ],
  },
  {
    title: 'IT Support Specialist',
    company: 'TeleHealth Solution',
    location: 'Remote - Contract',
    period: 'June 2021 - Oct. 2021',
    achievements: [
      'Implemented PTO calendar system using SharePoint Framework with React/TypeScript to streamline employee time-off management',
