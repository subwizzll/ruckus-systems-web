---

<Layout title="Jared Russell - Data Engineer & AI Concierge | Resume" description="Resume of Jared Russell, a Data Engineer and AI Concierge at Ruckus Systems. Specializing in data pipelines, automation, and practical AI solutions.">
  <div class="resume-root">
    <div class="resume-actions" role="toolbar" aria-label="Resume page actions">
      <a href="/" class="resume-back-link">
        ← Back to Home
      </a>
      <button type="button" id="resume-print-btn" class="resume-print-btn">
        Download / Print PDF
      </button>
    </div>

    <main class="resume-main">
      <header class="resume-header">
        <h1 class="resume-name">Jared Russell</h1>
        <p class="resume-title">Data Engineer &amp; AI Concierge</p>
        <div class="resume-contact">
          <span>North Carolina</span>
          {contactItems.map((item) => (
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {item.text}
            </a>
          ))}
        </div>
      </header>

      <section class="resume-section resume-summary">
        <h2 class="resume-section-title">Summary</h2>
        <p class="resume-summary-text">{summary}</p>
      </section>

      <section class="resume-section">
        <h2 class="resume-section-title">Professional Experience</h2>
        <div class="resume-exp-list">
          {experiences.map((exp) => (
            <article class="resume-exp-item">
              <div class="resume-exp-header">
                <h3 class="resume-exp-title">{exp.title}</h3>
                <span class="resume-exp-period">{exp.period}</span>
              </div>
              <div class="resume-exp-company">
                {exp.company} | {exp.location}
              </div>
              <ul class="resume-exp-achievements">
                {exp.achievements.map((achievement) => (
                  <li>{achievement}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="resume-section resume-edu">
        <h2 class="resume-section-title">Education</h2>
        <h3 class="resume-edu-school">Blue Ridge Community College</h3>
        <p class="resume-edu-location">Hendersonville, NC</p>
        <p class="resume-edu-degree">
          Associate of Applied Science in Computer Programming and Development
        </p>
        <p class="resume-edu-year">Class of 2022 | GPA: 3.845</p>
      </section>
    </main>

    <div class="resume-footer">
      <p>References available upon request.</p>
    </div>
    <script is:inline type="application/ld+json" set:html={personJsonLd} />
    <script is:inline>
      document.getElementById('resume-print-btn')?.addEventListener('click', () => window.print())
    </script>
  </div>
</Layout>

<style>
  .resume-root {
    max-width: 56rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  @media print {
    .resume-root { max-width: none; padding: 0; }
    .resume-actions,
    .resume-footer { display: none !important; }
  }

  .resume-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 3rem;
  }

  .resume-back-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .resume-back-link:hover { color: var(--solar-blue); }

  .resume-print-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background-color: var(--color-bg-alt);
    color: var(--color-text);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .resume-print-btn:hover { background-color: var(--color-border); }

  .resume-main {
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background-color: var(--color-bg);
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  @media (min-width: 768px) { .resume-main { padding: 3rem; } }

  @media print {
    .resume-main { border: none; padding: 0; box-shadow: none; background: #fff; }
  }

  .resume-header {
    margin-bottom: 1.5rem;
    padding-bottom: 0;
    border-bottom: none;
  }

  .resume-summary {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    break-inside: avoid;
  }

  .resume-summary-text {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text);
    margin: 0;
  }

  .resume-name {
    font-size: 2.25rem;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-heading);
    margin-bottom: 0.25rem;
  }

  .resume-title {
    font-size: 1.125rem;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.8rem;
    color: var(--color-secondary);
  }
  .resume-contact a {
    color: var(--color-secondary);
    text-decoration: none;
    font-family: var(--font-mono);
    transition: color 0.2s ease;
  }
  .resume-contact a:hover { color: var(--solar-blue); }

  .resume-section { margin-bottom: 2.5rem; }
  .resume-section-title {
    font-size: 1rem;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-heading);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .resume-exp-list { display: flex; flex-direction: column; gap: 2rem; }

  .resume-exp-item { break-inside: avoid; }

  .resume-exp-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .resume-exp-title {
    font-size: 1rem;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-heading);
    margin-bottom: 0;
  }

  .resume-exp-period {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-secondary);
    white-space: nowrap;
  }

  .resume-exp-company {
    font-size: 0.8rem;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .resume-exp-achievements {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .resume-exp-achievements li {
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-text);
    padding-left: 1rem;
    position: relative;
  }
  .resume-exp-achievements li::before {
    content: '>';
    font-family: var(--font-mono);
    color: var(--solar-blue);
    position: absolute;
    left: 0;
  }

  .resume-edu { border-top: 1px solid var(--color-border); padding-top: 2rem; break-inside: avoid; }

  .resume-edu-school {
    font-size: 1rem;
    font-family: var(--font-mono);
    color: var(--color-heading);
    margin-bottom: 0.125rem;
  }
  .resume-edu-location, .resume-edu-year {
    font-size: 0.8rem;
    color: var(--color-text);
    margin-bottom: 0;
  }
  .resume-edu-degree {
    font-size: 0.875rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .resume-footer {
    margin-top: 3rem;
    text-align: center;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-secondary);
  }
</style>
