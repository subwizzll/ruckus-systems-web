---
import Analytics from '@vercel/analytics/astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CoffeeTip from '../components/CoffeeTip.astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
  noindex?: boolean
}

const {
  title = 'Asheville AI & Data Engineering | Ruckus Systems',
  description = 'Expert Data Engineering and AI Concierge services in Asheville, NC. Automate workflows, build robust data pipelines, and leverage practical AI for your business.',
  image = '/og-image.png',
  noindex = false,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Jared Russell" />
    <meta name="theme-color" content="#fdf6e3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#002b36" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Ruckus Systems" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <!-- 48x48 for Google search results (must be multiple of 48px) -->
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192x192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon-512x512.png" type="image/png" sizes="512x512" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <Analytics />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Ruckus Systems",
        "image": "https://ruckussystems.dev/logo.png",
        "url": "https://ruckussystems.dev",
        "telephone": "828-357-7556",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "",
          "addressLocality": "Asheville",
          "addressRegion": "NC",
          "postalCode": "28801",
          "addressCountry": "US"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 35.5951,
          "longitude": -82.5515
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ],
          "opens": "09:00",
          "closes": "17:00"
        },
        "priceRange": "$$"
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col" style="background-color:var(--color-bg);color:var(--color-text)">
    <Header />
    <slot />
    <Footer />
    <CoffeeTip />
  </body>
</html>
