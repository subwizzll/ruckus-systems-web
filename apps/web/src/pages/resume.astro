---
import Layout from '../layouts/Layout.astro'

const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jared Russell',
  jobTitle: 'Data Engineer & AI Concierge',
  url: 'https://ruckussystems.dev/resume',
  image: 'https://ruckussystems.dev/headshot.jpeg',
  telephone: '828-357-7556',
  email: 'jared@ruckussystems.dev',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Asheville',
    addressRegion: 'NC',
    addressCountry: 'US',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'Ruckus Systems',
    url: 'https://ruckussystems.dev',
  },
  sameAs: [
    'https://linkedin.com/in/ruckussystems',
    'https://github.com/subwizzll',
  ],
  knowsAbout: [
    'Data Engineering',
    'AI Automation',
    'Data Pipelines',
    'Python',
    'TypeScript',
    'PostgreSQL',
    'AWS',
  ],
})

const contactItems = [
  { text: '828-357-7556', href: 'tel:828-357-7556' },
  { text: 'jared@ruckussystems.dev', href: 'mailto:jared@ruckussystems.dev' },
  { text: 'linkedin.com/in/ruckussystems', href: 'https://linkedin.com/in/ruckussystems' },
  { text: 'github.com/subwizzll', href: 'https://github.com/subwizzll' },
]

const experiences = [
  {
    title: 'Full Stack Engineer -> Data Engineer',
    company: 'Healthbook+',
    location: 'Remote - Full-time',
    period: 'Feb. 2024 - Present',
    achievements: [
      'Served as sole triage specialist using Jira, DataDog, Sentry, and AWS CloudWatch to identify and resolve production issues, achieving 99.5% uptime',
      'Researched and implemented end-to-end testing frameworks for React Native CI/CD pipeline using TypeScript to reduce QA overhead by 60% and enable weekly releases',
      'Developed comprehensive PDF health record reports using Python, Django, PostgreSQL, and React Native to provide patients with consolidated medical data',
      'Implemented Sentry Replays and Crash Reports with custom TypeScript logging overrides to improve error tracking accuracy by 85%',
      'Built mobile app integration with wearables using Java, Spring Framework, and PostgreSQL to enable real-time health data synchronization for 5,000+ active users',
      'Developed internal health record systems with Docker, LocalStack, S3, SQS, and EKS to integrate with multiple vendor APIs, reducing data processing time by 40%',
      'Integrated Zendesk into legacy backend systems using Java and Spring Framework to streamline support ticket management and improve customer service workflows',
    ],
  },
  {
    title: '.NET Developer',
    company: 'R+L Carriers',
    location: 'Remote - Full-time',
    period: 'Apr. 2023 - Feb. 2024',
    achievements: [
      'Built comprehensive fuel and mileage reporting system using C#, JavaScript, ASP.NET Core, and MS SQL Server to replace legacy system, delivering data 70% faster',
      'Overhauled tablet logging system with proper event sequence management and timestamp handling to ensure 100% FMCSA compliance for driver logs',
      'Developed ELD-compliant features using ASP.NET and Xamarin to meet Federal Electronic Logging Device Mandate requirements',
    ],
  },
  {
    title: 'Software Engineer',
    company: 'Bank Mobile Technologies Inc.',
    location: 'Remote - Full-time',
    period: 'Oct. 2021 - Feb. 2023',
    achievements: [
      'Delivered Peer-to-Peer and Shared Savings features for T-Mobile Money app using Xamarin.Forms and ASP.NET Core to serve 500,000+ active users',
      'Implemented A11y features with custom Effects, MarkupExtensions, and Renderers to achieve AA+ WCAG compliance status for T-Mobile Money',
      'Delivered solutions ahead of schedule through proactive backend collaboration to achieve zero-defect releases at dev-lock for 12 consecutive sprints',
    ],
  },
  {
    title: 'Software Engineer',
    company: 'Harvest RFID',
    location: 'Remote - Contract',
    period: 'Jan. 2021 - March 2022',
    achievements: [
      'Developed real-time inventory management mobile app using Xamarin.Forms with Bluetooth Low Energy RFID integration to replace manual pen-and-paper processes, saving $10,000+ annually',
      'Built and deployed ASP.NET Core RESTful backend with cost analysis across Azure and AWS platforms to optimize deployment strategy, saving $3,000+ per year through on-premises solution',
      'Configured AppCenter Crashes and Distribution for crash analytics and deployment to improve bug resolution speed by 95%',
    ],
  },
  {
    title: 'IT Support Specialist',
    company: 'TeleHealth Solution',
    location: 'Remote - Contract',
    period: 'June 2021 - Oct. 2021',
    achievements: [
      'Implemented PTO calendar system using SharePoint Framework with React/TypeScript to streamline employee time-off management',
      'Developed Azure Function with CRON scheduling to automate O365 Management Activity API log collection and MongoDB caching, saving 2 hours per new employee onboarding',
    ],
  },
]
---

<Layout title="Jared Russell - Data Engineer & AI Concierge | Resume" description="Resume of Jared Russell, a Data Engineer and AI Concierge based in Asheville, NC. Specializing in data pipelines, automation, and practical AI solutions.">
  <div class="mx-auto max-w-4xl px-6 py-12 print:max-w-none print:py-0">
    <div class="mb-12 flex items-center justify-between print:hidden">
      <a href="/" class="flex items-center gap-2 text-slate-500 transition-colors hover:text-slate-900 dark:hover:text-slate-100">
        Back to Home
      </a>
      <button
        type="button"
        onclick="window.print()"
        class="print-button inline-flex items-center gap-2 rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
      >
        Download / Print PDF
      </button>
    </div>

    <main class="rounded-2xl border border-slate-100 bg-white p-8 shadow-sm md:p-12 print:border-none print:p-0 print:shadow-none dark:border-slate-800 dark:bg-slate-950">
      <header class="mb-8 border-b border-slate-200 pb-8 dark:border-slate-800">
        <h1 class="mb-2 text-4xl font-bold text-slate-900 dark:text-white">Jared Russell</h1>
        <p class="text-xl text-slate-600 dark:text-slate-400">Data Engineer & AI Concierge</p>
        <div class="mt-4 flex flex-wrap gap-4 text-sm text-slate-500 dark:text-slate-400">
          <span>Asheville, NC</span>
          {contactItems.map((item) => (
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="transition-colors hover:text-slate-900 dark:hover:text-slate-100"
            >
              {item.text}
            </a>
          ))}
        </div>
      </header>

      <section class="mb-10">
        <h2 class="mb-4 border-b border-slate-100 pb-2 text-xl font-bold uppercase tracking-wider text-slate-900 dark:border-slate-800 dark:text-white">
          Professional Experience
        </h2>
        <div class="space-y-8">
          {experiences.map((exp) => (
            <article class="break-inside-avoid">
              <div class="mb-2 flex items-baseline justify-between">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">{exp.title}</h3>
                <span class="rounded bg-slate-50 px-2 py-1 text-sm font-medium text-slate-500 dark:bg-slate-900">
                  {exp.period}
                </span>
              </div>
              <div class="mb-2 text-sm font-medium text-slate-700 dark:text-slate-300">
                {exp.company} | {exp.location}
              </div>
              <ul class="space-y-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                {exp.achievements.map((achievement) => (
                  <li>{achievement}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="break-inside-avoid border-t border-slate-100 pt-8 dark:border-slate-800">
        <h2 class="mb-4 text-xl font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Education
        </h2>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Blue Ridge Community College</h3>
        <p class="text-slate-600 dark:text-slate-400">Hendersonville, NC</p>
        <p class="font-medium text-slate-700 dark:text-slate-300">
          Associate of Applied Science in Computer Programming and Development
        </p>
        <p class="mt-2 text-slate-600 dark:text-slate-400">Class of 2022 | GPA: 3.845</p>
      </section>
    </main>

    <div class="mt-12 text-center text-sm text-slate-400 print:hidden">
      <p>References available upon request.</p>
    </div>
    <script is:inline type="application/ld+json" set:html={personJsonLd} />
  </div>
</Layout>
