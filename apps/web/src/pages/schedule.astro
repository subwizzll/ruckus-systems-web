---
import Layout from "../layouts/Layout.astro";
import BookingModal from "../components/BookingModal.astro";
---

<Layout
  title="Schedule a Session | Ruckus Systems"
  description="Book a strategy session, automation audit, or AI implementation pilot with Ruckus Systems in Asheville, NC. Secure online booking with Stripe."
>
  <section class="bg-slate-50 px-6 py-20 dark:bg-slate-900">
    <div class="mx-auto max-w-4xl text-center">
      <h1 class="mb-4 text-4xl font-bold">Schedule a Session</h1>
      <p class="mx-auto max-w-2xl text-lg text-slate-600 dark:text-slate-300">
        Book your strategy call or workflow audit. Payments are secured with Stripe.
      </p>
      <button
        data-booking-open
        class="mt-8 inline-flex h-12 items-center justify-center rounded-full bg-blue-600 px-8 text-lg font-semibold text-white hover:bg-blue-700"
      >
        Open Booking
      </button>
    </div>
  </section>
  <BookingModal />
</Layout>
