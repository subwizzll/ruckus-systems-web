---
import Layout from "../layouts/Layout.astro";

const token = Astro.url.searchParams.get("token");
if (!token) {
  return Astro.redirect("/");
}
---

<Layout title="Cancel Appointment | Ruckus Systems" noindex>
  <div class="cancel-root">
    <h1>Cancel Appointment</h1>

    <div id="cancel-loading" class="info-card">Loading booking details...</div>
    <div id="cancel-error" class="error-card hidden"></div>

    <div id="cancel-body" class="hidden space-y-4">
      <div class="info-card">
        <h2>Booking details</h2>
        <p><strong>Service:</strong> <span id="service-title"></span></p>
        <p><strong>Time:</strong> <span id="start-time"></span></p>
        <p><strong>Refund policy:</strong> <span id="refund-policy"></span></p>
      </div>
      <button id="confirm-cancel" class="danger-btn">
        Confirm cancellation
      </button>
    </div>
  </div>
</Layout>

<style>
  .cancel-root {
    max-width: 32rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .cancel-root h1 {
    font-size: 1.875rem;
    font-family: var(--font-mono);
    color: var(--color-heading);
    margin-bottom: 1.5rem;
  }
  .info-card {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    background-color: var(--color-bg-alt);
    color: var(--color-text);
    line-height: 1.7;
  }
  .info-card h2 {
    font-size: 1.125rem;
    font-family: var(--font-mono);
    color: var(--color-heading);
    margin-bottom: 0.5rem;
  }
  .error-card {
    border: 1px solid var(--solar-red);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    background-color: color-mix(in srgb, var(--solar-red) 10%, transparent);
    color: var(--solar-red);
  }
  .danger-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3rem;
    padding: 0 1.5rem;
    background-color: var(--solar-red);
    color: var(--solar-base3);
    font-family: var(--font-mono);
    font-size: 1rem;
    border-radius: 0.5rem;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .danger-btn:hover { opacity: 0.85; }
</style>

<script is:inline define:vars={{ token }}>
  async function init() {
    const loading = document.getElementById("cancel-loading");
    const error = document.getElementById("cancel-error");
    const body = document.getElementById("cancel-body");
    try {
      const res = await fetch(`/api/booking/cancel?token=${token}`);
      const data = await res.json();
      if (!data.success) throw new Error(data.error || "Invalid link");
      document.getElementById("service-title").textContent = data.data.serviceTitle;
      document.getElementById("start-time").textContent = new Date(data.data.startTime).toLocaleString();
      document.getElementById("refund-policy").textContent = data.data.eligibleForRefund
        ? "Eligible for full refund (>24h)"
        : "No refund (<24h)";
      loading.classList.add("hidden");
      body.classList.remove("hidden");
    } catch (err) {
      loading.classList.add("hidden");
      error.textContent = err instanceof Error ? err.message : "Unable to load booking";
      error.classList.remove("hidden");
    }
  }

  document.getElementById("confirm-cancel")?.addEventListener("click", async () => {
    const res = await fetch("/api/booking/cancel", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token, confirmed: true }),
    });
    const data = await res.json();
    if (!data.success) {
      alert(data.error || "Failed to cancel booking");
      return;
    }
    alert("Booking cancelled.");
    window.location.href = "/";
  });

  init();
</script>
