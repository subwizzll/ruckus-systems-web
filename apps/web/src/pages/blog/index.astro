---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/blog/PostCard.astro";

const allPosts = (await getCollection("blog", ({ data }: CollectionEntry<"blog">) => {
  return import.meta.env.PROD ? data.draft !== true : true;
})).sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const tags = [...new Set(allPosts.flatMap((post: CollectionEntry<"blog">) => post.data.tags))] as string[];
---

<Layout
  title="Blog | Ruckus Systems"
  description="Insights on data engineering, AI agents, and building in the open. By Jared Russell."
>
  <main class="blog-index">
    <!-- Hero Section -->
    <section class="blog-hero">
      <div class="blog-hero-inner">
        <h1 class="blog-hero-title">Blog</h1>
        <p class="blog-hero-subtitle">
          Insights on data engineering, AI agents, and things we're building.
        </p>
      </div>
    </section>

    <!-- Tag Filter -->
    {tags.length > 0 && (
      <nav class="tag-filter" aria-label="Filter by tag">
        <div class="tag-filter-inner">
          <a href="/blog" class="tag-pill active">All</a>
          {tags.map((tag: string) => (
            <a href={`/blog/tags/${tag}`} class="tag-pill">{tag}</a>
          ))}
        </div>
      </nav>
    )}

    <!-- Posts Grid -->
    <section class="posts-grid-section">
      <div class="posts-grid">
        {allPosts.length > 0 ? (
          allPosts.map((post: CollectionEntry<"blog">) => <PostCard post={post} />)
        ) : (
          <div class="empty-state">
            <p>No posts yet. Check back soon!</p>
          </div>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  .blog-index {
    min-height: 80vh;
  }

  /* Hero */
  .blog-hero {
    padding: 4rem 1.5rem 2rem;
    text-align: center;
  }

  .blog-hero-inner {
    max-width: 700px;
    margin-inline: auto;
  }

  .blog-hero-title {
    font-family: var(--font-mono);
    font-size: 3rem;
    font-weight: 400;
    color: var(--color-heading);
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
  }

  .blog-hero-subtitle {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.2rem;
    color: var(--color-secondary);
    line-height: 1.6;
  }

  /* Tag Filter */
  .tag-filter {
    padding: 0 1.5rem;
    margin-bottom: 2rem;
  }

  .tag-filter-inner {
    max-width: 900px;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.35em 0.9em;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    color: var(--color-secondary);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .tag-pill:hover,
  .tag-pill.active {
    background: var(--solar-blue);
    color: var(--color-bg);
    border-color: var(--solar-blue);
  }

  /* Grid */
  .posts-grid-section {
    padding: 0 1.5rem 4rem;
  }

  .posts-grid {
    max-width: 900px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 0;
    font-family: Georgia, "Times New Roman", serif;
    color: var(--color-secondary);
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .blog-hero-title {
      font-size: 2.2rem;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
