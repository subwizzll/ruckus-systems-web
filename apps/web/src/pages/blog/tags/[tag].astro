---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PostCard from "../../../components/blog/PostCard.astro";
import TagBadge from "../../../components/blog/TagBadge.astro";

const { tag } = Astro.params;
if (!tag) {
  return Astro.redirect("/blog");
}

const allPosts = await getCollection("blog", ({ data }: CollectionEntry<"blog">) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const filteredPosts = allPosts
  .filter((post: CollectionEntry<"blog">) => post.data.tags.includes(tag))
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
  );

const allTags = [...new Set(allPosts.flatMap((post: CollectionEntry<"blog">) => post.data.tags))] as string[];
---

<Layout
  title={`Posts tagged "${tag}" | Ruckus Systems Blog`}
  description={`All blog posts tagged with "${tag}".`}
>
  <main class="tag-archive">
    <section class="tag-header">
      <div class="tag-header-inner">
        <a href="/blog" class="back-link">← All Posts</a>
        <h1 class="tag-title">
          <span class="tag-label">Tagged:</span>
          <TagBadge tag={tag} />
        </h1>
        <p class="tag-count">
          {filteredPosts.length} post{filteredPosts.length !== 1 ? "s" : ""}
        </p>
      </div>
    </section>

    <!-- Other tags -->
    <nav class="tag-nav" aria-label="Other tags">
      <div class="tag-nav-inner">
        {allTags.map((t: string) => (
          <a
            href={`/blog/tags/${t}`}
            class={`tag-pill ${t === tag ? "active" : ""}`}
          >
            {t}
          </a>
        ))}
      </div>
    </nav>

    <section class="posts-section">
      <div class="posts-grid">
        {filteredPosts.length > 0 ? (
          filteredPosts.map((post: CollectionEntry<"blog">) => <PostCard post={post} />)
        ) : (
          <div class="empty-state">
            <p>No posts with this tag yet.</p>
          </div>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  .tag-archive {
    min-height: 80vh;
  }

  .tag-header {
    padding: 3rem 1.5rem 1.5rem;
    text-align: center;
  }

  .tag-header-inner {
    max-width: 700px;
    margin-inline: auto;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-secondary);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--solar-blue);
  }

  .tag-title {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 400;
    color: var(--color-heading);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .tag-label {
    color: var(--color-secondary);
  }

  .tag-count {
    font-size: 0.95rem;
    color: var(--color-secondary);
  }

  .tag-nav {
    padding: 0 1.5rem;
    margin-bottom: 2rem;
  }

  .tag-nav-inner {
    max-width: 900px;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.35em 0.9em;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    color: var(--color-secondary);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .tag-pill:hover,
  .tag-pill.active {
    background: var(--solar-blue);
    color: var(--color-bg);
    border-color: var(--solar-blue);
  }

  .posts-section {
    padding: 0 1.5rem 4rem;
  }

  .posts-grid {
    max-width: 900px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 0;
    font-family: Georgia, "Times New Roman", serif;
    color: var(--color-secondary);
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .tag-title {
      font-size: 1.5rem;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
