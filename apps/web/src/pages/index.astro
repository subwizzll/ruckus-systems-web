---
import Layout from '../layouts/Layout.astro'
import BookingModal from '../components/BookingModal.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

const services = await getCollection('services')

const serviceButtonToneClasses = [
  'service-cta-primary',
  'service-cta-secondary',
  'service-cta-accent-sage',
  'service-cta-accent-terracotta',
  'service-cta-accent-gold',
  'service-cta-accent-teal',
] as const
---

<Layout title="Ruckus Systems | AI & Automation Consulting">
  <main class="flex min-h-screen flex-col text-slate-900 dark:text-slate-100">
    <section class="relative flex flex-col items-center space-y-8 bg-linear-to-b from-slate-50 to-slate-100 px-6 py-20 text-center md:px-12 lg:px-24 dark:from-slate-900 dark:to-slate-800">
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 md:text-6xl dark:text-white">
        Automate the Boring.<br />
        <span class="text-blue-600 dark:text-blue-400">Analyze the Important.</span>
      </h1>
      <p class="mx-auto max-w-2xl text-lg leading-relaxed text-slate-600 md:text-xl dark:text-slate-300">
        I help Asheville businesses with data, practical AI, and automation—so you spend less time on spreadsheets and manual work.
      </p>
      <div class="flex flex-col gap-4 pt-4 sm:flex-row">
        <a
          href="#book-now"
          data-booking-open
          data-service="strategy-call"
          class="inline-flex h-12 items-center justify-center rounded-full border-none bg-blue-600 px-8 text-lg font-semibold text-white! shadow-lg transition-colors hover:bg-blue-700"
        >
          Book a Strategy Call
        </a>
      </div>
    </section>

    <section id="services" class="bg-white px-6 py-20 md:px-12 lg:px-24 dark:bg-slate-950">
      <div class="mx-auto max-w-6xl">
        <h2 class="mb-3 text-center text-3xl font-bold">Services</h2>
        <p class="mx-auto mb-12 max-w-3xl text-center text-slate-600 dark:text-slate-400">
          Pick what fits your need and click to book. Strategy Call, Workflow Audit, and Data Pipeline include a written follow-up and a quote for more work.
        </p>
        <div class="grid gap-8 md:grid-cols-2">
          {services.map((entry: CollectionEntry<'services'>, i: number) => (
              <article class="service-card-home rounded-2xl border border-[var(--surface-soft-border)] bg-[var(--surface-soft)] p-8 transition-all hover:border-[var(--accent-sage)] hover:shadow-xl dark:border-slate-800 dark:bg-slate-900">
                <div class="mb-4 flex items-start justify-between gap-4">
                  <h3 class="text-2xl font-bold">{entry.data.title}</h3>
                  <div class="text-right">
                    <p class="text-2xl font-bold text-slate-900 dark:text-white">{entry.data.price}</p>
                    <p class="text-sm text-slate-600 dark:text-slate-400">{entry.data.duration} minutes</p>
                  </div>
                </div>
                <p class="mb-6 leading-relaxed text-slate-600 dark:text-slate-400">
                  {entry.data.description}
                </p>
                <a
                  href="#book-now"
                  data-booking-open
                  data-service={entry.id}
                  class={`inline-flex h-11 items-center justify-center rounded-full border-none px-6 font-semibold transition-colors ${
                    serviceButtonToneClasses[i % serviceButtonToneClasses.length]
                  }`}
                >
                  Book {entry.data.title}
                </a>
              </article>
            ))}
        </div>
      </div>
    </section>

    <section id="about" class="bg-slate-50 px-6 py-20 md:px-12 lg:px-24 dark:bg-slate-900">
      <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-3">
        <article class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-950">
          <h3 class="mb-2 text-lg font-semibold">Clear ROI Focus</h3>
          <p class="text-slate-600 dark:text-slate-400">
            Every suggestion is about saving time, reducing risk, or making more money.
          </p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-950">
          <h3 class="mb-2 text-lg font-semibold">Hands-On Delivery</h3>
          <p class="text-slate-600 dark:text-slate-400">
            I build and set things up for you—not just advice, but real systems you can use.
          </p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-950">
          <h3 class="mb-2 text-lg font-semibold">Local Context</h3>
          <p class="text-slate-600 dark:text-slate-400">
            Built for Asheville businesses—not one-size-fits-all templates.
          </p>
        </article>
      </div>
    </section>

    <section id="book-now" class="bg-slate-900 px-6 py-24 text-center text-white">
      <div class="mx-auto max-w-3xl space-y-6">
        <h2 class="text-3xl font-bold md:text-4xl">Ready to simplify how you work?</h2>
        <p class="text-xl text-slate-300">
          Book a call to find the best next step for your business—AI, data, or automation.
        </p>
        <p class="text-slate-400">
          Your first strategy, workflow, or data call is free when you hire for additional services. Follow-up notes and a quote are included.
        </p>
        <div class="pt-8">
          <a
            href="#book-now"
            data-booking-open
            data-service="strategy-call"
            class="inline-flex h-14 items-center justify-center rounded-full border-none bg-blue-600 px-10 text-xl font-semibold text-white shadow-lg transition-colors hover:bg-blue-700"
          >
            Book Strategy Call
          </a>
          <p class="mt-4 text-sm text-slate-500">Secure booking and payment.</p>
        </div>
      </div>
    </section>

    <BookingModal />
  </main>
  <style>
    .service-cta-primary {
      background-color: var(--brand-blue);
      color: #fff;
    }
    .service-cta-primary:hover {
      background-color: #1d4ed8;
    }
    :is(.dark) .service-cta-primary {
      color: #fff;
    }

    .service-cta-secondary {
      background-color: #0f172a;
      color: #fff;
    }
    .service-cta-secondary:hover {
      background-color: #334155;
    }
    :is(.dark) .service-cta-secondary {
      background-color: #e2e8f0;
      color: #0f172a;
    }
    :is(.dark) .service-cta-secondary:hover {
      background-color: #f1f5f9;
    }

    .service-cta-accent-sage {
      background-color: var(--accent-sage);
      color: #fff;
    }
    .service-cta-accent-sage:hover {
      background-color: #3f5b43;
    }

    .service-cta-accent-terracotta {
      background-color: var(--accent-terracotta);
      color: #fff;
    }
    .service-cta-accent-terracotta:hover {
      background-color: #8f452b;
    }

    .service-cta-accent-gold {
      background-color: var(--accent-gold);
      color: #0f172a;
    }
    .service-cta-accent-gold:hover {
      background-color: #d4a61f;
    }

    .service-cta-accent-teal {
      background-color: var(--accent-teal);
      color: #fff;
    }
    .service-cta-accent-teal:hover {
      background-color: #6a8a8a;
    }
  </style>
  <script>
    import { initServiceCtaTones } from '../lib/random-service-cta-tones'
    initServiceCtaTones()
  </script>
</Layout>
