---
import Layout from '../layouts/Layout.astro'
import BookingModal from '../components/BookingModal.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

const services = await getCollection('services')

const serviceButtonToneClasses = [
  'service-cta-primary',
  'service-cta-secondary',
  'service-cta-accent-sage',
  'service-cta-accent-terracotta',
  'service-cta-accent-gold',
  'service-cta-accent-teal',
] as const
---

<Layout title="Data Engineer & AI Concierge in Asheville | Ruckus Systems">
  <main class="flex min-h-screen flex-col text-slate-900 dark:text-slate-100">
    <section class="relative flex flex-col items-center space-y-8 bg-linear-to-b from-slate-50 to-slate-100 px-6 py-20 text-center md:px-12 lg:px-24 dark:from-slate-900 dark:to-slate-800">
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 md:text-6xl dark:text-white">
        Engineering-Grade<br />
        <span class="text-blue-600 dark:text-blue-400">AI & Automation for Asheville</span>
      </h1>
      <p class="mx-auto max-w-2xl text-lg leading-relaxed text-slate-600 md:text-xl dark:text-slate-300">
        Don't just automate tasks. Build intelligent data systems that drive profit. We deliver measurable ROI through robust data pipelines and custom AI solutions.
      </p>
      <div class="flex flex-col gap-4 pt-4 sm:flex-row">
        <a
          href="#book-now"
          data-booking-open
          data-service="strategy-call"
          class="inline-flex h-12 items-center justify-center rounded-full border-none bg-blue-600 px-8 text-lg font-semibold text-white! shadow-lg transition-colors hover:bg-blue-700"
        >
          Book Your Strategy Session
        </a>
      </div>
    </section>

    <section id="services" class="bg-white px-6 py-20 md:px-12 lg:px-24 dark:bg-slate-950">
      <div class="mx-auto max-w-6xl">
        <h2 class="mb-3 text-center text-3xl font-bold">Services</h2>
        <p class="mx-auto mb-12 max-w-3xl text-center text-slate-600 dark:text-slate-400">
          Pick what fits your need and click to book. Strategy Call, Workflow Audit, and Data Pipeline include a written follow-up and a quote for more work.
        </p>
        <div class="grid gap-8 md:grid-cols-2">
          {services.map((entry: CollectionEntry<'services'>, i: number) => (
              <article class="service-card-home rounded-2xl border border-[var(--surface-soft-border)] bg-[var(--surface-soft)] p-8 transition-all hover:border-[var(--accent-sage)] hover:shadow-xl dark:border-slate-800 dark:bg-slate-900">
                <div class="mb-4 flex items-start justify-between gap-4">
                  <h3 class="text-2xl font-bold">{entry.data.title}</h3>
                  <div class="text-right">
                    <p class="text-2xl font-bold text-slate-900 dark:text-white">{entry.data.price}</p>
                    <p class="text-sm text-slate-600 dark:text-slate-400">{entry.data.duration} minutes</p>
                  </div>
                </div>
                <p class="mb-6 leading-relaxed text-slate-600 dark:text-slate-400">
                  {entry.data.description}
                </p>
                <a
                  href="#book-now"
                  data-booking-open
                  data-service={entry.id}
                  class={`inline-flex h-11 items-center justify-center rounded-full border-none px-6 font-semibold transition-colors ${
                    serviceButtonToneClasses[i % serviceButtonToneClasses.length]
                  }`}
                >
                  Book {entry.data.title}
                </a>
              </article>
            ))}
        </div>
      </div>
    </section>

    <section id="results" class="bg-slate-50 px-6 py-20 md:px-12 lg:px-24 dark:bg-slate-900">
      <div class="mx-auto max-w-6xl">
        <h2 class="mb-3 text-center text-3xl font-bold">Proven Results</h2>
        <p class="mx-auto mb-12 max-w-3xl text-center text-slate-600 dark:text-slate-400">
          We don't just advise; we build systems that work. From this site's booking and payments to enterprise integrations, here are examples of the impact we deliver.
        </p>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
          <article class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all hover:shadow-md dark:border-slate-800 dark:bg-slate-950">
            <h3 class="mb-4 text-xl font-bold text-slate-900 dark:text-white">Custom Booking & Payments</h3>
            <p class="leading-relaxed text-slate-600 dark:text-slate-400">
              This site runs on a custom booking platform we built, with Stripe payment integration so clients can schedule sessions and pay securely. We deliver the same kind of tailored scheduling and payment flows for your business.
            </p>
          </article>
          <article class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all hover:shadow-md dark:border-slate-800 dark:bg-slate-950">
            <h3 class="mb-4 text-xl font-bold text-slate-900 dark:text-white">Intelligent Support Automation</h3>
            <p class="leading-relaxed text-slate-600 dark:text-slate-400">
              We integrate platforms like Zendesk into complex legacy systems to streamline ticket management and improve customer service workflows, reducing resolution times and manual overhead.
            </p>
          </article>
          <article class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all hover:shadow-md dark:border-slate-800 dark:bg-slate-950">
            <h3 class="mb-4 text-xl font-bold text-slate-900 dark:text-white">High-Performance Data Pipelines</h3>
            <p class="leading-relaxed text-slate-600 dark:text-slate-400">
              We engineer robust data pipelines that aggregate disparate sources and deliver critical business insights. Our optimized architectures have delivered reporting data up to 70% faster than legacy systems.
            </p>
          </article>
          <article class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all hover:shadow-md dark:border-slate-800 dark:bg-slate-950">
            <h3 class="mb-4 text-xl font-bold text-slate-900 dark:text-white">Automated Client Outreach</h3>
            <p class="leading-relaxed text-slate-600 dark:text-slate-400">
              We build automated outreach workflows using tools like SendGrid to drive engagement and retention. Our systems ensure timely client follow-ups are triggered automatically, removing manual effort from your team.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="about" class="border-t border-slate-200 bg-white px-6 py-20 md:px-12 lg:px-24 dark:border-slate-800 dark:bg-slate-950">
      <div class="mx-auto max-w-6xl">
        <h2 class="mb-3 text-center text-3xl font-bold text-slate-900 dark:text-white">Why Us</h2>
        <p class="mx-auto mb-12 max-w-3xl text-center text-slate-600 dark:text-slate-400">
          Our approach is what sets us apart from generic automation shops.
        </p>
        <div class="grid gap-8 md:grid-cols-3">
          <article class="about-card rounded-r-2xl border border-slate-200 border-l-4 border-l-blue-600 bg-slate-50/50 p-6 dark:border-slate-700 dark:border-l-blue-500 dark:bg-slate-900/50">
            <h3 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">Engineered for ROI</h3>
            <p class="text-slate-600 dark:text-slate-400">
              Every project starts with a data-driven model of impact. We don't just "speed things up"—we deploy systems that measurably reduce cost-to-serve and increase capacity.
            </p>
          </article>
          <article class="about-card rounded-r-2xl border border-slate-200 border-l-4 border-l-blue-600 bg-slate-50/50 p-6 dark:border-slate-700 dark:border-l-blue-500 dark:bg-slate-900/50">
            <h3 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">Data-First Architecture</h3>
            <p class="text-slate-600 dark:text-slate-400">
              Automation without good data is just faster chaos. We build the data pipelines first, ensuring your AI and workflows are reliable, accurate, and scalable.
            </p>
          </article>
          <article class="about-card rounded-r-2xl border border-slate-200 border-l-4 border-l-blue-600 bg-slate-50/50 p-6 dark:border-slate-700 dark:border-l-blue-500 dark:bg-slate-900/50">
            <h3 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">Asheville's Technical Partner</h3>
            <p class="text-slate-600 dark:text-slate-400">
              Enterprise-grade engineering for Asheville businesses. We bring the rigor of big tech to your local operations, providing a level of reliability that freelance scripts can't match.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="book-now" class="bg-slate-900 px-6 py-24 text-center text-white">
      <div class="mx-auto max-w-3xl space-y-6">
        <h2 class="text-3xl font-bold md:text-4xl">Ready to engineer your growth?</h2>
        <p class="text-xl text-slate-300">
          Book a strategy session to map your highest-value opportunities for automation and data intelligence.
        </p>
        <p class="text-slate-400">
          Your initial strategy roadmap is credited towards any implementation project. Follow-up notes and a detailed quote are included.
        </p>
        <div class="pt-8">
          <a
            href="#book-now"
            data-booking-open
            data-service="strategy-call"
            class="inline-flex h-14 items-center justify-center rounded-full border-none bg-blue-600 px-10 text-xl font-semibold text-white shadow-lg transition-colors hover:bg-blue-700"
          >
            Book Your Strategy Session
          </a>
          <p class="mt-4 text-sm text-slate-500">Secure booking and payment.</p>
        </div>
      </div>
    </section>

    <BookingModal />
  </main>
  <style>
    .service-cta-primary {
      background-color: var(--brand-blue);
      color: #fff;
    }
    .service-cta-primary:hover {
      background-color: #1d4ed8;
    }
    :is(.dark) .service-cta-primary {
      color: #fff;
    }

    .service-cta-secondary {
      background-color: #0f172a;
      color: #fff;
    }
    .service-cta-secondary:hover {
      background-color: #334155;
    }
    :is(.dark) .service-cta-secondary {
      background-color: #e2e8f0;
      color: #0f172a;
    }
    :is(.dark) .service-cta-secondary:hover {
      background-color: #f1f5f9;
    }

    .service-cta-accent-sage {
      background-color: var(--accent-sage);
      color: #fff;
    }
    .service-cta-accent-sage:hover {
      background-color: #3f5b43;
    }

    .service-cta-accent-terracotta {
      background-color: var(--accent-terracotta);
      color: #fff;
    }
    .service-cta-accent-terracotta:hover {
      background-color: #8f452b;
    }

    .service-cta-accent-gold {
      background-color: var(--accent-gold);
      color: #0f172a;
    }
    .service-cta-accent-gold:hover {
      background-color: #d4a61f;
    }

    .service-cta-accent-teal {
      background-color: var(--accent-teal);
      color: #fff;
    }
    .service-cta-accent-teal:hover {
      background-color: #6a8a8a;
    }
  </style>
  <script>
    import { initServiceCtaTones } from '../lib/random-service-cta-tones'
    initServiceCtaTones()
  </script>
</Layout>
