---
import TagBadge from "./TagBadge.astro";
import ReadingTime from "./ReadingTime.astro";

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      heroImage?: string;
      tags: string[];
      draft?: boolean;
    };
    body?: string;
  };
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;

const formattedDate = new Date(pubDate).toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});

const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 250));
---

<a href={`/blog/${post.id}`} class="post-card" id={`post-card-${post.id}`}>
  <div class="card-image-wrapper">
    {heroImage ? (
      <img
        src={heroImage}
        alt={title}
        class="card-image"
        loading="lazy"
        onerror="this.style.display='none'"
      />
    ) : null}
  </div>
  <div class="card-body">
    <div class="card-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      <span class="card-sep">·</span>
      <ReadingTime minutes={readingTime} />
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-description">{description}</p>
    {tags.length > 0 && (
      <div class="card-tags">
        {tags.slice(0, 3).map((tag) => (
          <TagBadge tag={tag} />
        ))}
        {tags.length > 3 && (
          <span class="more-tags">+{tags.length - 3}</span>
        )}
      </div>
    )}
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    min-width: 0; /* allow shrinking in grid so image doesn’t drive card width */
    height: 100%;
    width: 100%;
    max-width: 400px;
    justify-content: flex-start;
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-bg);
    transition: all 0.3s ease;
    padding: 0;
    margin: 0;
  }

  .post-card:hover {
    border-color: var(--solar-blue);
    box-shadow: 0 8px 32px rgba(38, 139, 210, 0.08);
    transform: translateY(-2px);
  }

  @media (prefers-color-scheme: dark) {
    .post-card:hover {
      box-shadow: 0 8px 32px rgba(38, 139, 210, 0.15);
    }
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    min-width: 0;
    height: 200px;
    flex-shrink: 0;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-border) 0%, var(--color-bg-alt, var(--color-border)) 100%);
  }

  .card-image {
    display: block;
    width: 100%;
    min-width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
    object-position: center;
    vertical-align: middle;
    transition: transform 0.3s ease;
  }

  .post-card:hover .card-image {
    transform: scale(1.03);
  }

  .card-body {
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--color-secondary);
    font-family: var(--font-body);
  }

  .card-sep {
    color: var(--color-border-highlight);
  }

  .card-title {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-heading);
    line-height: 1.3;
    margin: 0;
  }

  .card-description {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.95rem;
    color: var(--color-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .more-tags {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-secondary);
    padding: 0.2em 0.4em;
  }
</style>
