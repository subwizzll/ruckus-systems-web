---
// Dialog-only component. Trigger buttons live in Header.astro (desktop + mobile).
---

<dialog id="coffee-tip-dialog" class="coffee-tip-dialog">
  <div class="dialog-content">
    <div class="dialog-header">
      <div class="dialog-title-row">
        <span class="text-2xl" aria-hidden="true">☕</span>
        <h2 class="dialog-title">Buy Me a Coffee</h2>
      </div>
      <form method="dialog">
        <button type="submit" class="dialog-close-btn" aria-label="Close">✕</button>
      </form>
    </div>
    <p class="dialog-sub">
      Enjoying this site? Power up my code with a jolt of liquid inspiration!
    </p>

    <div id="coffee-tip-presets" class="tip-presets">
      <button type="button" data-tip-amount="5" class="coffee-tip-preset-btn">$5</button>
      <button type="button" data-tip-amount="10" class="coffee-tip-preset-btn">$10</button>
      <button type="button" data-tip-amount="25" class="coffee-tip-preset-btn">$25</button>
      <button type="button" data-tip-amount="50" class="coffee-tip-preset-btn">$50</button>
    </div>

    <div class="tip-custom-row">
      <span class="tip-or">or</span>
      <div class="tip-custom-wrap">
        <span class="tip-dollar">$</span>
        <input
          id="coffee-tip-custom-amount"
          type="number"
          min="1"
          max="500"
          step="1"
          placeholder="Custom"
          class="tip-custom-input"
        />
      </div>
    </div>

    <button id="coffee-tip-submit-btn" type="button" class="tip-submit-btn">
      <span id="coffee-tip-btn-label">Send a Coffee ☕</span>
    </button>

    <p id="coffee-tip-error" class="tip-error hidden"></p>
  </div>
</dialog>

<style>
  .coffee-tip-dialog {
    margin: auto;
    width: 100%;
    max-width: min(90vw, 24rem);
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg);
    padding: 1.5rem;
    box-shadow: 0 8px 40px rgba(0,0,0,0.15);
  }
  .coffee-tip-dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }

  .dialog-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .dialog-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dialog-title {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--color-heading);
    margin: 0;
  }

  .dialog-close-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem 0.6rem;
    border-radius: 0.375rem;
    color: var(--color-secondary);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .dialog-close-btn:hover {
    background-color: var(--color-border);
    color: var(--color-heading);
  }

  .dialog-sub {
    font-size: 0.875rem;
    color: var(--color-text);
    margin: 0;
  }

  .tip-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .coffee-tip-preset-btn {
    background-color: var(--color-bg);
    border: 2px solid var(--color-border);
    border-radius: 9999px;
    padding: 0.375rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .coffee-tip-preset-btn:hover {
    border-color: var(--solar-yellow);
    color: var(--solar-yellow);
  }
  .coffee-tip-preset-btn.active {
    border-color: var(--solar-yellow);
    color: var(--solar-yellow);
    background-color: color-mix(in srgb, var(--solar-yellow) 10%, transparent);
  }

  .tip-custom-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tip-or {
    font-size: 0.8rem;
    color: var(--color-secondary);
  }

  .tip-custom-wrap {
    position: relative;
  }
  .tip-dollar {
    position: absolute;
    inset: 0 auto 0 0.625rem;
    display: flex;
    align-items: center;
    color: var(--color-secondary);
    pointer-events: none;
  }

  .tip-custom-input {
    width: 6rem;
    border-radius: 9999px;
    border: 2px solid var(--color-border);
    background-color: var(--color-bg);
    padding: 0.375rem 0.5rem 0.375rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
    outline: none;
    text-align: center;
    transition: border-color 0.2s ease;
  }
  .tip-custom-input:focus { border-color: var(--solar-yellow); }

  .tip-submit-btn {
    width: 100%;
    border-radius: 9999px;
    background-color: var(--solar-yellow);
    color: var(--solar-base03);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    padding: 0.625rem 0;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .tip-submit-btn:hover { opacity: 0.88; }
  .tip-submit-btn:disabled { opacity: 0.45; cursor: not-allowed; }

  .tip-error {
    font-size: 0.8rem;
    color: var(--solar-red);
    margin: 0;
  }
</style>

<script>
  (function () {
    const triggers = document.querySelectorAll<HTMLElement>('.coffee-tip-trigger');
    const dialog = document.getElementById('coffee-tip-dialog') as HTMLDialogElement | null;
    const presetBtns = document.querySelectorAll<HTMLButtonElement>('.coffee-tip-preset-btn');
    const customInput = document.getElementById('coffee-tip-custom-amount') as HTMLInputElement | null;
    const submitBtn = document.getElementById('coffee-tip-submit-btn') as HTMLButtonElement | null;
    const btnLabel = document.getElementById('coffee-tip-btn-label');
    const errorEl = document.getElementById('coffee-tip-error');

    let selectedAmount: number | null = null;

    function setActive(amount: number) {
      selectedAmount = amount;
      presetBtns.forEach((b) => b.classList.remove('active'));
      const match = [...presetBtns].find((b) => Number((b as HTMLButtonElement).dataset.tipAmount) === amount);
      if (match) match.classList.add('active');
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        dialog?.showModal();
      });
    });

    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const amt = Number(btn.dataset.tipAmount);
        setActive(amt);
        if (customInput) customInput.value = '';
      });
    });

    customInput?.addEventListener('input', () => {
      presetBtns.forEach((b) => b.classList.remove('active'));
      selectedAmount = customInput.value ? Number(customInput.value) : null;
    });

    submitBtn?.addEventListener('click', async () => {
      const amount = selectedAmount ?? (customInput?.value ? Number(customInput.value) : null);

      if (errorEl) {
        errorEl.textContent = '';
        errorEl.classList.add('hidden');
      }

      if (!amount || amount < 1) {
        if (errorEl) {
          errorEl.textContent = 'Please choose or enter an amount first.';
          errorEl.classList.remove('hidden');
        }
        return;
      }
      if (amount > 500) {
        if (errorEl) {
          errorEl.textContent = 'Maximum tip is $500.';
          errorEl.classList.remove('hidden');
        }
        return;
      }

      submitBtn.disabled = true;
      if (btnLabel) btnLabel.textContent = 'Loading…';

      try {
        const res = await fetch('/api/payment/tip', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount }),
        });
        const data = await res.json();

        if (data.success && data.url) {
          window.location.href = data.url;
        } else {
          throw new Error(data.error || 'Something went wrong');
        }
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
          errorEl.classList.remove('hidden');
        }
        submitBtn.disabled = false;
        if (btnLabel) btnLabel.textContent = 'Send a Coffee ☕';
      }
    });

    // Thank-you toast when returning from Stripe tip success
    if (new URLSearchParams(window.location.search).get('tip') === 'thanks') {
      const toast = document.createElement('div');
      toast.textContent = "☕ Thanks so much — you're awesome!";
      toast.style.cssText = `
        position:fixed; bottom:24px; left:50%; transform:translateX(-50%);
        background:var(--solar-yellow); color:var(--solar-base03); padding:12px 24px; border-radius:9999px;
        font-family:var(--font-mono); font-weight:400; font-size:1rem; box-shadow:0 4px 24px rgba(0,0,0,.18);
        z-index:9999; opacity:0; transition:opacity .4s;
      `;
      document.body.appendChild(toast);
      requestAnimationFrame(() => {
        toast.style.opacity = '1';
      });
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 400);
        history.replaceState({}, '', window.location.pathname + window.location.hash || '');
      }, 4000);
    }
  })();
</script>
