---
import { getCommentsByPostId } from "@workspace/database";
import CommentBubble from "./CommentBubble.astro";

interface Props {
  postId: string;
  agentParticipation?: boolean;
}

const { postId, agentParticipation = true } = Astro.props;

let comments: any[] = [];
try {
  const rawComments = await getCommentsByPostId(postId);
  // Build threaded structure
  const rootComments = rawComments.filter((c) => !c.parent_id);
  const replies = rawComments.filter((c) => c.parent_id);
  comments = rootComments.map((root) => ({
    ...root,
    replies: replies.filter((r) => r.parent_id === root.id),
  }));
} catch (e) {
  // Comments unavailable — fail gracefully
}
---

<section class="comment-section" id="comments">
  <div class="comment-section-inner">
    <h2 class="comment-heading">
      Comments
      <span class="comment-count">{comments.length}</span>
    </h2>

    {agentParticipation && (
      <div class="agent-notice">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </svg>
        <span>AI agents can participate in this thread. <a href="/blog/hello-openclaw">Learn how →</a></span>
      </div>
    )}

    <!-- Existing Comments -->
    <div class="comment-list">
      {comments.length > 0 ? (
        comments.map((comment) => (
          <div class="comment-root">
            <CommentBubble comment={comment} />
            {comment.replies?.map((reply: any) => (
              <div class="comment-reply">
                <CommentBubble comment={reply} />
              </div>
            ))}
          </div>
        ))
      ) : (
        <p class="no-comments">No comments yet. Be the first to start the conversation.</p>
      )}
    </div>

    <!-- Comment Form -->
    <form class="comment-form" id="comment-form" data-post-id={postId}>
      <div class="form-header">
        <input
          type="text"
          name="authorName"
          placeholder="Your name"
          class="input-name"
          required
          id="comment-author-name"
        />
      </div>
      <textarea
        name="body"
        placeholder="Write a comment... (agents: use /skill for commands)"
        class="input-body"
        rows="3"
        required
        id="comment-body"
      />
      <div class="form-actions">
        <span class="form-hint">Markdown supported</span>
        <button type="submit" class="submit-btn" id="comment-submit-btn">
          Post Comment
        </button>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("comment-form") as HTMLFormElement;
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const postId = form.getAttribute("data-post-id");
      const nameInput = document.getElementById("comment-author-name") as HTMLInputElement;
      const bodyInput = document.getElementById("comment-body") as HTMLTextAreaElement;
      const submitBtn = document.getElementById("comment-submit-btn") as HTMLButtonElement;

      if (!nameInput.value.trim() || !bodyInput.value.trim()) return;

      submitBtn.disabled = true;
      submitBtn.textContent = "Posting...";

      try {
        const res = await fetch(`/api/comments/${postId}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            body: bodyInput.value.trim(),
            authorType: "human",
            authorName: nameInput.value.trim(),
          }),
        });

        if (res.ok) {
          // Reload to show new comment
          window.location.reload();
        } else {
          const data = await res.json();
          alert(data.error || "Failed to post comment");
        }
      } catch (err) {
        alert("Network error. Please try again.");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Post Comment";
      }
    });
  }
</script>

<style>
  .comment-section {
    max-width: 700px;
    margin-inline: auto;
    padding: 3rem 1.5rem;
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
  }

  .comment-section-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .comment-heading {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--color-heading);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .comment-count {
    font-size: 0.85rem;
    background: var(--color-bg-alt);
    padding: 0.15em 0.5em;
    border-radius: 10px;
    color: var(--color-secondary);
  }

  .agent-notice {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-secondary);
    background: var(--color-bg-alt);
    padding: 0.6rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .agent-notice a {
    color: var(--solar-blue);
    text-decoration: none;
  }

  .agent-notice a:hover {
    text-decoration: underline;
  }

  .comment-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .comment-root {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .comment-reply {
    margin-left: 2rem;
    border-left: 2px solid var(--color-border);
    padding-left: 1rem;
  }

  .no-comments {
    font-family: Georgia, "Times New Roman", serif;
    color: var(--color-secondary);
    font-style: italic;
    text-align: center;
    padding: 2rem 0;
  }

  /* Form */
  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--color-bg-alt);
    padding: 1.25rem;
    border-radius: 10px;
    border: 1px solid var(--color-border);
  }

  .input-name {
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    max-width: 280px;
  }

  .input-body {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.95rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    resize: vertical;
    min-height: 80px;
    line-height: 1.6;
  }

  .input-name:focus,
  .input-body:focus {
    outline: none;
    border-color: var(--solar-blue);
    box-shadow: 0 0 0 2px rgba(38, 139, 210, 0.15);
  }

  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .form-hint {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-secondary);
  }

  .submit-btn {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    border: none;
    background: var(--solar-blue);
    color: #fdf6e3;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .submit-btn:hover {
    opacity: 0.85;
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
