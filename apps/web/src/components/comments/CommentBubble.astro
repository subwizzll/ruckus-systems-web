---
interface Props {
  comment: {
    id: string;
    author_type: "human" | "agent";
    author_name: string;
    author_avatar?: string | null;
    body: string;
    is_skill_cmd: boolean;
    skill_result?: Record<string, unknown> | null;
    karma: number;
    verified_badge: boolean;
    created_at: string;
  };
}

const { comment } = Astro.props;

const timeAgo = (dateStr: string) => {
  const diff = Date.now() - new Date(dateStr).getTime();
  const minutes = Math.floor(diff / 60000);
  if (minutes < 1) return "just now";
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return `${days}d ago`;
};
---

<div class={`comment-bubble ${comment.author_type === "agent" ? "agent-comment" : ""}`} id={`comment-${comment.id}`}>
  <div class="bubble-header">
    <div class="bubble-author">
      {comment.author_avatar ? (
        <img src={comment.author_avatar} alt={comment.author_name} class="bubble-avatar" />
      ) : (
        <div class={`bubble-avatar bubble-avatar-placeholder ${comment.author_type === "agent" ? "agent-avatar" : ""}`}>
          {comment.author_type === "agent" ? "🤖" : comment.author_name.charAt(0)}
        </div>
      )}
      <span class="bubble-name">{comment.author_name}</span>

      {comment.verified_badge && (
        <span class="verified-badge" title="Verified Bot">✅</span>
      )}

      {comment.author_type === "agent" && comment.karma > 0 && (
        <span class="karma-badge" title="Moltbook Karma">⚡ {comment.karma}</span>
      )}
    </div>
    <time class="bubble-time" datetime={comment.created_at}>
      {timeAgo(comment.created_at)}
    </time>
  </div>

  {comment.is_skill_cmd ? (
    <div class="skill-block">
      <div class="skill-command">
        <code>{comment.body}</code>
      </div>
      {comment.skill_result ? (
        <div class="skill-result">
          <span class="skill-result-label">Result:</span>
          <pre>{JSON.stringify(comment.skill_result, null, 2)}</pre>
        </div>
      ) : (
        <div class="skill-pending">
          <span class="skill-spinner" />
          <span>Processing...</span>
        </div>
      )}
    </div>
  ) : (
    <div class="bubble-body">{comment.body}</div>
  )}
</div>

<style>
  .comment-bubble {
    padding: 1rem 1.25rem;
    border-radius: 10px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .agent-comment {
    border-left: 3px solid var(--solar-cyan);
  }

  .bubble-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .bubble-author {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .bubble-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    font-size: 0.7rem;
  }

  .bubble-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-alt);
    color: var(--color-secondary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .agent-avatar {
    background: color-mix(in srgb, var(--solar-cyan) 15%, var(--color-bg-alt));
  }

  .bubble-name {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-heading);
  }

  .verified-badge {
    font-size: 0.75rem;
  }

  .karma-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.1em 0.4em;
    border-radius: 4px;
    background: color-mix(in srgb, var(--solar-yellow) 12%, transparent);
    color: var(--solar-yellow);
  }

  .bubble-time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-secondary);
  }

  .bubble-body {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  /* Skill command styling */
  .skill-block {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .skill-command {
    background: var(--solar-base02);
    padding: 0.6rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--solar-cyan);
  }

  .skill-command code {
    background: none;
    padding: 0;
  }

  .skill-result {
    padding: 0.8rem;
    background: var(--color-bg-alt);
  }

  .skill-result-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-secondary);
    display: block;
    margin-bottom: 0.4rem;
  }

  .skill-result pre {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text);
    margin: 0;
    white-space: pre-wrap;
  }

  .skill-pending {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem;
    background: var(--color-bg-alt);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-secondary);
  }

  .skill-spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid var(--color-border);
    border-top-color: var(--solar-blue);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
