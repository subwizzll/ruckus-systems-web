---
interface Props {
  token: string;
  pageTitle?: string;
  redirectUrl?: string;
  apiBaseUrl?: string;
  apiKey?: string;
}

const {
  token,
  pageTitle = "Cancel Appointment",
  redirectUrl = "/",
  apiBaseUrl = import.meta.env.PUBLIC_RUCKUS_BOOKING_API_URL || "",
  apiKey = import.meta.env.PUBLIC_RUCKUS_API_KEY || "",
} = Astro.props;

const normalizedApiBase = apiBaseUrl.replace(/\/$/, "");
---

<div class="cancel-root" data-redirect-url={redirectUrl} data-api-base-url={normalizedApiBase} data-api-key={apiKey}>
  <h1>{pageTitle}</h1>

    <div id="cancel-loading" class="info-card">Loading booking details...</div>
    <div id="cancel-error" class="error-card hidden"></div>

    <div id="cancel-body" class="hidden space-y-4">
      <div class="info-card">
        <h2>Booking details</h2>
        <p><strong>Service:</strong> <span id="service-title"></span></p>
        <p><strong>Time:</strong> <span id="start-time"></span></p>
        <p><strong>Refund policy:</strong> <span id="refund-policy"></span></p>
      </div>
      <button id="confirm-cancel" class="danger-btn">
        Confirm cancellation
      </button>
    </div>
</div>

<style>
  .cancel-root {
    max-width: 32rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .cancel-root h1 {
    font-size: 1.875rem;
    font-family: var(--font-mono);
    color: var(--color-heading);
    margin-bottom: 1.5rem;
  }
  .info-card {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    background-color: var(--color-bg-alt);
    color: var(--color-text);
    line-height: 1.7;
  }
  .info-card h2 {
    font-size: 1.125rem;
    font-family: var(--font-mono);
    color: var(--color-heading);
    margin-bottom: 0.5rem;
  }
  .error-card {
    border: 1px solid var(--solar-red);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    background-color: color-mix(in srgb, var(--solar-red) 10%, transparent);
    color: var(--solar-red);
  }
  .danger-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3rem;
    padding: 0 1.5rem;
    background-color: var(--solar-red);
    color: var(--solar-base3);
    font-family: var(--font-mono);
    font-size: 1rem;
    border-radius: 0.5rem;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .danger-btn:hover { opacity: 0.85; }
</style>

<script is:inline define:vars={{ token, redirectUrl }}>
  const root = document.querySelector(".cancel-root");
  const apiBaseUrl = (root?.getAttribute("data-api-base-url") || "").replace(/\/$/, "");
  const apiKey = root?.getAttribute("data-api-key") || "";

  function bookingApiUrl(centralPath, legacyPath) {
    return apiBaseUrl ? `${apiBaseUrl}${centralPath}` : legacyPath;
  }

  function bookingApiHeaders(extra = {}) {
    const headers = { ...extra };
    if (apiKey) headers.Authorization = `Bearer ${apiKey}`;
    return headers;
  }

  async function init() {
    const loading = document.getElementById("cancel-loading");
    const error = document.getElementById("cancel-error");
    const body = document.getElementById("cancel-body");
    try {
      const res = await fetch(bookingApiUrl(`/v1/cancel?token=${token}`, `/api/booking/cancel?token=${token}`), {
        headers: bookingApiHeaders(),
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || "Invalid link");
      document.getElementById("service-title").textContent = data.data.serviceTitle;
      document.getElementById("start-time").textContent = new Date(data.data.startTime).toLocaleString();
      document.getElementById("refund-policy").textContent = data.data.eligibleForRefund
        ? "Eligible for full refund (>24h)"
        : "No refund (<24h)";
      loading.classList.add("hidden");
      body.classList.remove("hidden");
    } catch (err) {
      loading.classList.add("hidden");
      error.textContent = err instanceof Error ? err.message : "Unable to load booking";
      error.classList.remove("hidden");
    }
  }

  document.getElementById("confirm-cancel")?.addEventListener("click", async () => {
    const res = await fetch(bookingApiUrl("/v1/cancel", "/api/booking/cancel"), {
      method: "POST",
      headers: bookingApiHeaders({ "Content-Type": "application/json" }),
      body: JSON.stringify({ token, confirmed: true }),
    });
    const data = await res.json();
    if (!data.success) {
      alert(data.error || "Failed to cancel booking");
      return;
    }
    alert("Booking cancelled.");
    window.location.href = redirectUrl;
  });

  init();
</script>
