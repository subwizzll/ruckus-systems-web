# Feature flags
BOOKING_ENABLED=true
PUBLIC_BOOKING_ENABLED=true
# Canonical URL for server-generated links (emails, calendar descriptions). Set in Vercel to your live origin (e.g. https://ruckussystems.dev).
PUBLIC_APP_URL=http://localhost:4321

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth / sessions
CLIENT_SECRET=replace_with_random_32plus_char_secret

# Stripe
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_API_VERSION=2025-07-30.basil

# Google Calendar service account
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SUBJECT_EMAIL=calendar-owner@yourdomain.com

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Email notifications (Resend)
RESEND_API_KEY=re_xxx
# Optional from-address (must be verified in Resend). If unset: Vercel production uses hello@ruckus.systems; other envs use onboarding@resend.dev.
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Cloudflare Turnstile (bot protection for free bookings)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional admin bootstrap
ADMIN_EMAIL=admin@ruckus.systems
ADMIN_PASSWORD=replace_me
ADMIN_NAME=Ruckus Admin
